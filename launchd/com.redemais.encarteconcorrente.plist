<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.redemais.encarteconcorrente</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/teste/Documents/encarteconcorrente/run_daily.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/teste/Documents/encarteconcorrente</string>
  <!-- roda a cada 30 min; o run_daily.sh se auto-limita a 1x por dia às 22h.
       Se o Mac estiver dormindo às 22h, o launchd dispara ao acordar. -->
  <key>StartInterval</key>
  <integer>1800</integer>
  <key>StandardOutPath</key>
  <string>/Users/teste/Documents/encarteconcorrente/data/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/teste/Documents/encarteconcorrente/data/launchd.err.log</string>
</dict>
</plist>
